{
  "name": "sistema-padaria",
  "version": "0.2.0",
  "description": "Canela Store — PDV, estoque e gestão para padarias",
  "author": "Canela",
  "private": true,
  "engines": {
    "node": "20.x"
  },
  "main": "electron/main.js",
  "scripts": {
    "dev": "node scripts/dev-web.mjs",
    "dev:plain": "next dev",
    "dev:turbo": "next dev --turbopack",
    "dev:clean": "node scripts/dev-web.mjs --clean",
    "prebuild": "node -e \"try{require('tailwindcss')}catch(e){console.log('Instalando devDependencies para o build…');require('child_process').execSync('npm install --include=dev --no-audit --no-fund',{stdio:'inherit'})}\"",
    "build": "next build",
    "build:render": "npm ci --include=dev && npm run build",
    "start": "next start",
    "lint": "next lint",
    "electron:dev": "electron .",
    "desktop:dev": "node electron/dev-runner.js",
    "dist:win": "electron-builder --win --config electron-builder.yml",
    "release:win": "npm run build && npm run dist:win",
    "db:migrate": "node --env-file=.env scripts/db-migrate.mjs",
    "db:seed": "node --env-file=.env scripts/db-seed.mjs",
    "db:push": "drizzle-kit push"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "bcryptjs": "^3.0.3",
    "brasilnfe": "^3.1.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.3",
    "jose": "^6.2.12",
    "jsbarcode": "^3.12.3",
    "lucide-react": "^0.468.0",
    "next": "^15.1.0",
    "nodemailer": "^10.0.14",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.0",
    "tailwind-merge": "^2.6.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.31.11",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "eslint": "^9.16.0",
    "eslint-config-next": "^15.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2"
  }
}
