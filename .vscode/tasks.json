{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Padaria: Next (porta 3000)",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "(Local:|Ready in|started server)"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "padaria-dev"
      }
    },
    {
      "label": "Padaria: Next limpo (.next)",
      "type": "shell",
      "command": "npm run dev:clean",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "(Local:|Ready in|started server)"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "padaria-dev"
      }
    }
  ]
}
