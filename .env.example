# Provedor: brasilnfe (agora) ou focusnfe (quando o adapter estiver pronto)
FISCAL_PROVIDER=brasilnfe
# homologacao até o cliente entregar o A1 e o CSC
FISCAL_AMBIENTE=homologacao

# Token da conta Brasil NFe. Vazio = o PDV continua em simulação e a venda não para.
BRASILNFE_TOKEN=
# Opcional, só para cadastrar empresa/certificado no painel deles
BRASILNFE_USER_TOKEN=

# Série da NFC-e. O número sai do provedor quando a emissão real estiver ligada.
NFCE_SERIE=1

# Certificado A1. Prefira o blob criptografado (CertificadoManager), não o .pfx solto.
# CERT_PATH=./certs/certificado_teste.pfx
# CERT_SENHA=
# CERT_ENCRYPTION_KEY=uma-frase-longa-so-no-servidor
# CERT_PFX_ENCRYPTED=
# CERT_SENHA_ENCRYPTED=

# Neon (use URL pooled do painel Neon)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Auth API (mín. 32 caracteres — gere: openssl rand -base64 48)
JWT_SECRET=

# Seed inicial (npm run db:seed)
# PLATFORM_SEED_EMAIL=master@canela.local
# PLATFORM_SEED_PASSWORD=master123
# TENANT_SEED_EMAIL=admin@loja.local
# TENANT_SEED_PASSWORD=admin123
# LEAD_NOTIFY_EMAIL=seu@email.com

# Leads do site — notificação por e-mail (destino no DB após migrate + seed ou painel master)
# Opção A: Resend (https://resend.com)
# RESEND_API_KEY=
# LEAD_EMAIL_FROM=contato@suaempresa.com.br

# Opção B: SMTP (Gmail, etc.)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# LEAD_EMAIL_FROM=contato@suaempresa.com.br
